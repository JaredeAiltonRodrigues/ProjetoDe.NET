@model OngDoacao.Models.Beneficiario

@{
    ViewData["Title"] = "Entrar na Fila";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Cadastre-se para receber Doação</h2>
        </div>
        <div class="card-body">
            <p>Preencha seus dados reais para que a ONG possa entrar em contato quando sua cesta estiver pronta.</p>

            <form asp-action="Cadastro" method="post" class="mt-4">
                <div class="mb-3">
                    <label class="form-label">Nome Completo</label>
                    <input asp-for="Nome" class="form-control" placeholder="João da Silva" required />
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">CPF</label>
                        <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tamanho da Família</label>
                        <input asp-for="TamanhoFamilia" type="number" class="form-control" placeholder="Ex: 4 pessoas" required min="1" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Telefone / WhatsApp</label>
                        <input asp-for="Telefone" class="form-control" placeholder="(11) 99999-9999" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">E-mail (Opcional)</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="joao@email.com" />
                    </div>
                </div>
                
                <div class="mt-4">
                    <button type="submit" class="btn btn-success btn-lg">Entrar na Fila</button>
                    <a href="/" class="btn btn-secondary btn-lg">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>