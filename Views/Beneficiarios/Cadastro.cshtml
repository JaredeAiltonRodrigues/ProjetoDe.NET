@model OngDoacao.Models.Beneficiario

@{
    ViewData["Title"] = "Solicitar apoio";
}

<div class="container mt-4 mb-5" style="max-width: 760px;">
    <nav aria-label="Navegação">
        <a asp-controller="Home" asp-action="Index">Voltar ao início</a>
    </nav>

    <h1 class="h2 mt-3">Solicitar apoio da ONG</h1>
    <p class="text-muted">Informe os dados necessários para que a equipe avalie o pedido e entre em contato.</p>

    <div class="alert alert-info" role="note">
        Seus dados serão usados para avaliar o pedido e organizar o atendimento. Consulte a
        <a asp-controller="Home" asp-action="Privacy">política de privacidade</a> antes de enviar.
    </div>

    <form asp-action="Cadastro" method="post" class="mt-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome completo</label>
            <input asp-for="Nome" class="form-control" autocomplete="name" maxlength="120" required />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Cpf" class="form-label">CPF</label>
                <input asp-for="Cpf" class="form-control" inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" required />
                <span asp-validation-for="Cpf" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TamanhoFamilia" class="form-label">Pessoas na família</label>
                <input asp-for="TamanhoFamilia" type="number" class="form-control" min="1" max="20" required />
                <span asp-validation-for="TamanhoFamilia" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Telefone" class="form-label">Telefone para contato</label>
                <input asp-for="Telefone" type="tel" class="form-control" autocomplete="tel" placeholder="(11) 99999-9999" required />
                <span asp-validation-for="Telefone" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">E-mail (opcional)</label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="254" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
        </div>

        <div class="form-check my-3">
            <input id="aceitePrivacidade" name="aceitePrivacidade" value="true" type="checkbox" class="form-check-input" required />
            <label for="aceitePrivacidade" class="form-check-label">Li a política de privacidade e confirmo que as informações são verdadeiras.</label>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Enviar solicitação</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}