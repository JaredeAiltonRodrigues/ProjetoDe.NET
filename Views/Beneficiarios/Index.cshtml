@model IEnumerable<OngDoacao.Models.Beneficiario>

@{
    ViewData["Title"] = "Gestão de Beneficiários";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🧑‍🤝‍🧑 Gestão da Fila de Doações</h2>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success fw-bold shadow-sm">@TempData["MensagemSucesso"]</div>
    }

    <!-- Tabela da Fila -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Pessoas Registadas no Sistema</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nome</th>
                        <th>Agregado Familiar</th>
                        <th>Contacto</th>
                        <th>Data Registo</th>
                        <th>Status</th>
                        <th class="text-center">Ações Rápidas</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted p-4">Não há beneficiários registados neste momento.</td>
                        </tr>
                    }
                    
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="fw-bold">@b.Nome</td>
                            <td>@b.TamanhoFamilia pessoas</td>
                            <td>@b.Telefone</td>
                            <td>@b.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if(b.StatusFila == "Aguardando") {
                                    <span class="badge bg-warning text-dark">Aguardando</span>
                                } else if (b.StatusFila == "Cesta Reservada") {
                                    <span class="badge bg-primary">Reservada (@b.HorarioRetirada?.ToString("dd/MM HH:mm"))</span>
                                } else {
                                    <span class="badge bg-success">Entregue</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- Botão para confirmar que a pessoa levantou a cesta -->
                                    @if(b.StatusFila == "Cesta Reservada") {
                                        <form asp-action="AtualizarStatus" method="post">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="novoStatus" value="Cesta Entregue" />
                                            <button type="submit" class="btn btn-sm btn-success fw-bold" title="Confirmar Entrega">
                                                ✔️ Entregue
                                            </button>
                                        </form>
                                    }
                                    
                                    <!-- Botão para remover ou cancelar o registo -->
                                    <form asp-action="Remover" method="post" onsubmit="return confirm('Tem a certeza que deseja eliminar o registo desta família?');">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Apagar Registo">
                                            🗑️ Remover
                                        </button>
                                    </form>

                                    <button onclick="window.print()" class="btn btn-outline-dark fw-bold shadow-sm">
                                        🖨️ Exportar para PDF
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>