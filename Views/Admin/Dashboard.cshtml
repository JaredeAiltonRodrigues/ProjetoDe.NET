@model OngDoacao.Models.DashboardViewModel

@{
    ViewData["Title"] = "Painel de gestão";

    var aguardando = Model.Fila.Count(p => p.StatusFila == "Aguardando");
    var previstos = Model.BeneficiariosPrevistos;
    var podeLiberar = Model.CestasDisponiveis > 0 && previstos.Count > 0;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root { --ink: #17261f; --forest: #1f4d3a; --grain: #e9b93a; --line: #dcd9cd; }
    body { font-family: 'Public Sans', system-ui, sans-serif; color: var(--ink); }
    .painel-gestao h1, .painel-gestao h2, .painel-gestao .valor { font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; font-weight: 800; letter-spacing: -.02em; }
    .painel-gestao h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); }
    .painel-gestao h2 { font-size: 1.4rem; }
    .resumo { border: 1px solid var(--line); border-left: 6px solid var(--forest); border-radius: 4px; padding: 1rem 1.25rem; background: #fff; height: 100%; }
    .resumo .valor { font-size: 2.6rem; line-height: 1.1; }
    .resumo.destaque { background: var(--ink); color: #fff; border-color: var(--ink); border-left-color: var(--grain); }
    .resumo.destaque .valor { color: var(--grain); }
    .bloco { border: 1px solid var(--line); border-radius: 4px; background: #fff; padding: 1.5rem; height: 100%; }
    .sugestao { border-left: 4px solid var(--grain); background: #fff6dc; padding: .9rem 1rem; border-radius: 0 4px 4px 0; }
    .tabela th { font-weight: 600; white-space: nowrap; background: #f1efe6; }
    .tabela td { vertical-align: middle; }
    .btn-forest { background: var(--forest); color: #fff; font-weight: 600; border-radius: 4px; padding: .8rem 1.5rem; }
    .btn-forest:hover:not(:disabled) { background: #17402f; color: #fff; }
    .btn-forest:disabled { background: #9aa8a0; color: #fff; }
    .atalhos .btn { border-radius: 4px; font-weight: 600; }
    .status-pendente { color: #8a5700; }
    .acoes-distribuicao form { display: inline-block; }
    :focus-visible { outline: 3px solid var(--grain); outline-offset: 2px; }
</style>

<div class="container painel-gestao mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="mb-0">Painel de gestão</h1>
        <nav class="atalhos d-flex flex-wrap gap-2" aria-label="Áreas do sistema">
            <a asp-controller="Alimentos" asp-action="Index" class="btn btn-outline-dark">Estoque</a>
            <a asp-controller="Financeiro" asp-action="Index" class="btn btn-outline-dark">Financeiro</a>
            <a asp-controller="Equipe" asp-action="Index" class="btn btn-outline-dark">Equipe (RH)</a>
            <a asp-controller="Beneficiarios" asp-action="Index" class="btn btn-outline-dark">Beneficiários</a>
            <a asp-controller="Escala" asp-action="Index" class="btn btn-outline-dark">Escala</a>
            <a asp-action="Doacoes" class="btn btn-forest">Histórico de doações</a>
        </nav>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar aviso"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar aviso"></button>
        </div>
    }

    <!-- Resumo -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-2">
            <section class="resumo" aria-label="Estoque atual">
                <div>Itens válidos no estoque</div>
                <div class="valor">@Model.TotalItensEstoque</div>
                <small class="text-muted">Itens dentro da validade</small>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="resumo destaque" aria-label="Cestas possíveis">
                <div>Cestas possíveis</div>
                <div class="valor">@Model.CestasDisponiveis</div>
                <small>Regra: 5 itens formam 1 cesta</small>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="resumo" aria-label="Fila de espera">
                <div>Famílias aguardando</div>
                <div class="valor">@aguardando</div>
                <small class="text-muted">Na fila de beneficiários</small>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="resumo" aria-label="Itens próximos do vencimento">
                <div>Vencem em 7 dias</div>
                <div class="valor">@Model.ItensVencendoEmSeteDias</div>
                <small class="text-muted">Priorize estes lotes</small>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="resumo" aria-label="Reservas em aberto">
                <div>Reservas ativas</div>
                <div class="valor">@Model.ReservasAtivas</div>
                <small class="text-muted">Aguardando retirada</small>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="resumo @(Model.NotificacoesPendentes > 0 ? "destaque" : "")" aria-label="Notificações pendentes">
                <div>Notificações pendentes</div>
                <div class="valor">@Model.NotificacoesPendentes</div>
                <small>Requerem e-mail ou reenvio</small>
            </section>
        </div>
    </div>

    @if (Model.ProximosVencimentos.Count > 0)
    {
        <section class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4" aria-label="Alerta de validade">
            <span><strong>Atenção ao vencimento:</strong> @Model.ItensVencendoEmSeteDias itens vencem nos próximos sete dias.</span>
            <a asp-controller="Alimentos" asp-action="Index" class="alert-link">Abrir estoque</a>
        </section>
    }

    <!-- Distribuição -->
    <section class="mb-4" aria-labelledby="titulo-distribuicao">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="bloco">
                    <h2 id="titulo-distribuicao" class="mb-3">Plano de distribuição</h2>

                    @if (Model.AssistenteDisponivel)
                    {
                        <div class="sugestao mb-3">
                            <div class="fw-semibold mb-1">Sugestão do assistente</div>
                            <div>@Model.SugestaoIA</div>
                            <small class="text-muted d-block mt-2">Gerada automaticamente. Revise antes de confirmar.</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="status">
                            @(Model.SugestaoIA ?? "O assistente não está disponível no momento.")
                            <div class="mt-1 small">O plano abaixo continua disponível para revisão e confirmação manual.</div>
                        </div>
                    }

                    <h3 class="h6 fw-bold">Beneficiários previstos <span class="fw-normal text-muted">(mais antigos primeiro)</span></h3>
                    @if (previstos.Count == 0)
                    {
                        <p class="mb-0 text-muted">Não há cestas suficientes ou famílias aguardando.</p>
                    }
                    else
                    {
                        <ol class="mb-0">
                            @foreach (var b in previstos)
                            {
                                <li>@b.Nome, família com @b.TamanhoFamilia @(b.TamanhoFamilia == 1 ? "pessoa" : "pessoas")</li>
                            }
                        </ol>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="bloco d-flex flex-column">
                                        <h2 class="mb-3">Confirmar reservas</h2>
                                        <p>Separa cinco unidades por família, reserva um horário e cria o histórico. A entrega só é registrada quando o recebimento for confirmado.</p>
                    <form asp-action="LiberarCestas" method="post" id="form-liberar" class="mt-auto"
                                                    data-confirm="Reservar e separar @previstos.Count @(previstos.Count == 1 ? "cesta" : "cestas") para os beneficiários listados?">
                                                <button type="submit" class="btn btn-forest w-100" disabled="@(!podeLiberar)">Reservar e separar alimentos</button>
                        @if (!podeLiberar)
                        {
                            <div class="form-text mt-2">Disponível quando houver cestas e famílias aguardando.</div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4" aria-labelledby="titulo-doacoes-recentes">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 id="titulo-doacoes-recentes" class="mb-1">Doações recentes</h2>
                <p class="text-muted mb-0">Produtos separados, retirada e situação da notificação.</p>
            </div>
            <a asp-action="Doacoes" class="btn btn-outline-dark">Ver histórico completo</a>
        </div>
        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0 tabela">
                <thead>
                    <tr>
                        <th scope="col">Beneficiário</th>
                        <th scope="col">Contato</th>
                        <th scope="col">Itens separados</th>
                        <th scope="col">Retirada</th>
                        <th scope="col">Entrega</th>
                        <th scope="col">Notificação</th>
                        <th scope="col" class="no-print">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DistribuicoesRecentes.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Ainda não há doações registradas. A reserva de cestas cria o histórico automaticamente.</td></tr>
                    }
                    @foreach (var distribuicao in Model.DistribuicoesRecentes)
                    {
                        <tr>
                            <td class="fw-semibold">@distribuicao.Beneficiario.Nome</td>
                            <td>@(distribuicao.Beneficiario.Telefone ?? "Sem telefone")</td>
                            <td><span class="small">@string.Join(", ", distribuicao.Itens.Select(item => $"{item.Quantidade} × {item.NomeAlimento}"))</span></td>
                            <td class="text-nowrap">@distribuicao.HorarioRetirada.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @(distribuicao.Status == "Entregue" ? "bg-success" : distribuicao.Status == "Reservada" ? "bg-primary" : "bg-secondary")">@distribuicao.Status</span></td>
                            <td>
                                <span class="@(distribuicao.StatusNotificacao == "Enviada" ? "text-success" : "status-pendente")">@distribuicao.StatusNotificacao</span>
                                @if (!string.IsNullOrWhiteSpace(distribuicao.DetalheNotificacao))
                                {
                                    <small class="d-block text-muted">@distribuicao.DetalheNotificacao</small>
                                }
                            </td>
                            <td class="no-print acoes-distribuicao">
                                @if (distribuicao.Status == "Reservada")
                                {
                                    <form asp-action="ReenviarNotificacao" method="post">
                                        <input type="hidden" name="id" value="@distribuicao.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Enviar e-mail</button>
                                    </form>
                                    @if (!string.IsNullOrWhiteSpace(distribuicao.Beneficiario.Telefone))
                                    {
                                        <form asp-action="RegistrarContatoManual" method="post" class="form-contato-manual">
                                            <input type="hidden" name="id" value="@distribuicao.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Registrar ligação</button>
                                        </form>
                                    }
                                    <form asp-action="ConfirmarEntrega" method="post" class="form-confirmar-entrega">
                                        <input type="hidden" name="id" value="@distribuicao.Id">
                                        <button type="submit" class="btn btn-sm btn-success">Confirmar entrega</button>
                                    </form>
                                    <form asp-action="CancelarDistribuicao" method="post" class="form-cancelar-distribuicao">
                                        <input type="hidden" name="id" value="@distribuicao.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar e devolver</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Fila -->
    <section aria-labelledby="titulo-fila">
        <h2 id="titulo-fila" class="mb-3">Fila de beneficiários</h2>
        <div class="table-responsive border rounded">
            <table class="table table-hover mb-0 tabela">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Família</th>
                        <th scope="col">Cadastro</th>
                        <th scope="col">Situação</th>
                        <th scope="col">Retirada</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Fila.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Nenhum beneficiário cadastrado ainda.</td></tr>
                    }
                    @foreach (var p in Model.Fila)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Nome</td>
                            <td>@p.TamanhoFamilia @(p.TamanhoFamilia == 1 ? "pessoa" : "pessoas")</td>
                            <td class="text-nowrap">@p.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (p.StatusFila == "Aguardando")
                                {
                                    <span class="badge bg-warning text-dark">@p.StatusFila</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@p.StatusFila</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @(p.HorarioRetirada.HasValue ? p.HorarioRetirada.Value.ToString("dd/MM/yyyy 'às' HH:mm") : "Não definido")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.form-cancelar-distribuicao').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!confirm('Cancelar a reserva e devolver os itens ao estoque?')) event.preventDefault();
            });
        });
        document.querySelectorAll('.form-contato-manual').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!confirm('Você confirmou o contato telefônico com o beneficiário?')) event.preventDefault();
            });
        });
        document.querySelectorAll('.form-confirmar-entrega').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!confirm('Confirmar que a pessoa recebeu os alimentos separados?')) event.preventDefault();
            });
        });

        // Confirmação antes de liberar as cestas e proteção contra clique duplo.
        document.getElementById('form-liberar').addEventListener('submit', function (e) {
            if (!confirm(this.dataset.confirm)) {
                e.preventDefault();
                return;
            }
            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.textContent = 'Liberando...';
        });
    </script>
}
