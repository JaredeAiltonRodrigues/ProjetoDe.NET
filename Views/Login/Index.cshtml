@{
    ViewData["Title"] = "Entrar no Sistema";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white text-center p-4">
                    <h3 class="mb-0">Acesso Restrito</h3>
                    <p class="mb-0 small">ONG Alimento para Todos</p>
                </div>
                <div class="card-body p-4 bg-light">
                    
                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["Erro"]</div>
                    }

                    <form asp-action="Entrar" method="post">
                        <div class="mb-3">
                            <label for="nome" class="form-label fw-bold">Nome de usuário</label>
                            <input id="nome" type="text" name="nome" class="form-control form-control-lg" autocomplete="username" required />
                        </div>
                        <div class="mb-4">
                            <label for="senha" class="form-label fw-bold">Senha</label>
                            <input id="senha" type="password" name="senha" class="form-control form-control-lg" autocomplete="current-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Entrar</button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>