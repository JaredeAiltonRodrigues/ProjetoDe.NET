@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Política de Privacidade";
    var razaoSocial = Configuration["Privacy:ControllerName"] ?? "ONG Alimento para Todos";
    var emailPrivacidade = Configuration["Privacy:ContactEmail"];
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root { --ink: #17261f; --forest: #1f4d3a; --grain: #e9b93a; --paper: #fbfaf6; --line: #dcd9cd; }
    body { font-family: 'Public Sans', system-ui, sans-serif; color: var(--ink); background: var(--paper); }
    h1, h2 { font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; letter-spacing: -.02em; }
    .policy-head { padding: 56px 0 32px; border-bottom: 1px solid var(--line); }
    .policy-head h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 800; line-height: 1.05; }
    .policy-head p { max-width: 60ch; }
    .policy-body { padding: 40px 0 72px; }
    .policy-nav { position: sticky; top: 1.5rem; }
    .policy-nav a { display: block; padding: .35rem 0 .35rem .9rem; border-left: 3px solid var(--line); color: var(--ink); text-decoration: none; }
    .policy-nav a:hover { border-left-color: var(--grain); }
    .policy-section { scroll-margin-top: 1.5rem; max-width: 68ch; margin-bottom: 2.5rem; }
    .policy-section h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: .75rem; }
    .policy-section p, .policy-section li { line-height: 1.7; }
    .policy-table { width: 100%; border-collapse: collapse; margin-top: .5rem; }
    .policy-table th, .policy-table td { text-align: left; vertical-align: top; padding: .65rem .75rem; border-bottom: 1px solid var(--line); }
    .policy-table th { font-weight: 600; background: #f1efe6; }
    .btn-grain { background: var(--grain); color: var(--ink); font-weight: 600; border: 0; border-radius: 4px; padding: .7rem 1.4rem; }
    .btn-grain:hover { background: #f0c75a; color: var(--ink); }
    :focus-visible { outline: 3px solid var(--grain); outline-offset: 3px; }
    html { scroll-behavior: smooth; }
    @@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    @@media (max-width: 991.98px) {
        .policy-nav { position: static; margin-bottom: 2rem; }
        .policy-body .row { --bs-gutter-x: 1.5rem; }
    }
</style>

<header class="policy-head">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p class="mt-3 mb-1">Esta página descreve os dados tratados pelas funções disponíveis neste sistema e como solicitar informações sobre eles.</p>
        <p class="text-muted mb-0">Revisada em 17 de outubro de 2026</p>
    </div>
</header>

<div class="policy-body">
    <div class="container">
        <div class="row g-5">
            <nav class="col-lg-3" aria-label="Nesta página">
                <div class="policy-nav">
                    <a href="#quem-somos">Quem somos</a>
                    <a href="#dados">Dados que coletamos</a>
                    <a href="#finalidades">Por que usamos seus dados</a>
                    <a href="#compartilhamento">Com quem compartilhamos</a>
                    <a href="#prazo">Por quanto tempo guardamos</a>
                    <a href="#direitos">Seus direitos</a>
                    <a href="#seguranca">Segurança</a>
                    <a href="#cookies">Cookies</a>
                    <a href="#menores">Crianças e adolescentes</a>
                    <a href="#alteracoes">Mudanças nesta política</a>
                    <a href="#contato">Fale com a gente</a>
                </div>
            </nav>

            <main class="col-lg-9">
                <div class="alert alert-warning" role="status">
                    Antes da publicação, a ONG deve configurar sua razão social, CNPJ e um canal oficial para privacidade. Este site não inventa esses dados.
                </div>
                <section id="quem-somos" class="policy-section">
                    <h2>Quem somos</h2>
                    <p>O sistema é utilizado pela @razaoSocial para organizar solicitações de apoio, estoque, equipe e registros financeiros. A identificação jurídica da entidade responsável deve ser confirmada pela própria ONG antes da publicação.</p>
                </section>

                <section id="dados" class="policy-section">
                    <h2>Dados que coletamos</h2>
                    <p>Coletamos apenas o necessário para cada atividade:</p>
                    <div class="table-responsive">
                        <table class="policy-table">
                            <thead><tr><th scope="col">Quem é você</th><th scope="col">Dados</th></tr></thead>
                            <tbody>
                                <tr><td>Família que solicita apoio</td><td>Nome, CPF, telefone, tamanho da família e e-mail opcional; também são registrados o status do pedido e o horário de retirada, quando definido.</td></tr>
                                <tr><td>Equipe e voluntários</td><td>Nome, telefone opcional, função, tipo de vínculo, perfil de acesso e escala. Senhas novas são armazenadas com hash.</td></tr>
                                <tr><td>Registros financeiros internos</td><td>Descrição, tipo, valor, forma de pagamento, identificação opcional do pagador e situação de conciliação ou nota fiscal.</td></tr>
                                <tr><td>Visitante do site</td><td>O sistema usa cookie de autenticação nas áreas restritas. Não há ferramenta de analytics configurada neste projeto.</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="mt-3">Não vendemos nem alugamos seus dados.</p>
                </section>

                <section id="finalidades" class="policy-section">
                    <h2>Por que usamos seus dados</h2>
                    <ul>
                        <li>Receber e avaliar solicitações de apoio, organizar a fila e registrar retiradas.</li>
                        <li>Controlar estoque, vencimentos e distribuição de alimentos.</li>
                        <li>Administrar contas de acesso, equipe e escalas.</li>
                        <li>Manter o livro-caixa interno e apoiar a prestação de contas.</li>
                    </ul>
                    <p>A ONG deve definir e documentar a base legal adequada a cada finalidade antes de operar com dados reais.</p>
                </section>

                <section id="compartilhamento" class="policy-section">
                    <h2>Com quem compartilhamos</h2>
                    <p>O sistema não possui integração ativa com banco ou meio de pagamento. Quando configurados pela organização, os serviços de e-mail podem receber o endereço necessário ao envio de avisos, e o assistente de IA recebe somente totais operacionais, sem nomes ou CPFs.</p>
                    <ul>
                        <li>acessos por membros autorizados da equipe, conforme o perfil de acesso;</li>
                        <li>fornecedores técnicos efetivamente configurados pela ONG;</li>
                        <li>autoridades, quando houver obrigação legal válida.</li>
                    </ul>
                </section>

                <section id="prazo" class="policy-section">
                    <h2>Por quanto tempo guardamos</h2>
                    <p>Este projeto não executa descarte automático. Os registros permanecem no banco de dados até que um administrador os remova ou que a organização implemente uma política de retenção. A ONG deve definir prazos compatíveis com suas obrigações legais.</p>
                </section>

                <section id="direitos" class="policy-section">
                    <h2>Seus direitos</h2>
                    <p>Você pode solicitar confirmação de tratamento, acesso, correção, anonimização ou exclusão quando aplicável, além de informações sobre compartilhamento. O pedido deve ser encaminhado ao canal oficial de privacidade da ONG.</p>
                    <p>Os direitos e prazos aplicáveis devem ser avaliados pelo responsável legal da organização.</p>
                    <ul>
                        <li>confirmação de que tratamos seus dados e acesso a eles;</li>
                        <li>correção de dados incompletos ou desatualizados;</li>
                        <li>anonimização, bloqueio ou exclusão de dados desnecessários;</li>
                        <li>portabilidade dos dados;</li>
                        <li>informação sobre com quem compartilhamos;</li>
                        <li>retirada do consentimento, o que não afeta o uso feito antes do pedido.</li>
                    </ul>
                    <p>Se achar que seus direitos não foram respeitados, você também pode reclamar à Autoridade Nacional de Proteção de Dados (ANPD).</p>
                </section>

                <section id="seguranca" class="policy-section">
                    <h2>Segurança</h2>
                    <p>O sistema restringe áreas internas por perfil, protege novas senhas com hash e usa cookies de autenticação. A implantação deve fornecer HTTPS, manter o banco fora do controle de versão, proteger as credenciais do ambiente e definir procedimentos de resposta a incidentes.</p>
                </section>

                <section id="cookies" class="policy-section">
                    <h2>Cookies</h2>
                    <p>O cookie de autenticação é usado para manter a sessão da equipe nas áreas restritas. Este projeto não configura cookies de publicidade ou analytics.</p>
                </section>

                <section id="menores" class="policy-section">
                    <h2>Crianças e adolescentes</h2>
                    <p>O formulário solicita a quantidade de pessoas da família, não nomes ou documentos de crianças. O pedido deve ser enviado por uma pessoa adulta responsável.</p>
                </section>

                <section id="alteracoes" class="policy-section">
                    <h2>Mudanças nesta política</h2>
                    <p>Esta página deve ser atualizada quando mudarem os dados coletados, integrações ou responsáveis pelo tratamento.</p>
                </section>

                <section id="contato" class="policy-section">
                    <h2>Fale com a gente</h2>
                    @if (!string.IsNullOrWhiteSpace(emailPrivacidade))
                    {
                        <p>Para exercer seus direitos ou tirar dúvidas, entre em contato com o canal informado pela ONG:</p>
                        <a href="mailto:@emailPrivacidade" class="btn btn-grain">Enviar e-mail</a>
                    }
                    else
                    {
                        <p class="mb-0">O canal de privacidade ainda não foi configurado. A ONG deve informar um contato oficial antes de publicar esta página.</p>
                    }
                </section>
            </main>
        </div>
    </div>
</div>
