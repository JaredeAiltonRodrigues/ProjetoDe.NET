@{
    ViewData["Title"] = "Início - ONG Alimento para Todos";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --ink: #17261f;
        --forest: #1f4d3a;
        --grain: #e9b93a;
        --paper: #fbfaf6;
        --line: #dcd9cd;
    }
    body { font-family: 'Public Sans', system-ui, sans-serif; color: var(--ink); background: var(--paper); }
    h1, h2, h3 { font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; color: var(--ink); text-transform: none; letter-spacing: 0; }
    .hero { padding: 72px 0 56px; }
    .hero h1 { font-size: 4rem; font-weight: 800; line-height: 1.05; }
    .hero p.lead { max-width: 34ch; }
    .hero-img { width: 100%; height: 100%; min-height: 320px; max-height: 480px; object-fit: cover; border-radius: 4px; }
    .btn-grain { background: var(--grain); color: var(--ink); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 1rem; border: 0; border-radius: 4px; padding: .8rem 1.6rem; }
    .btn-grain:hover { background: #f0c75a; color: var(--ink); }
    .btn-line { border: 2px solid var(--ink); color: var(--ink); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 1rem; border-radius: 4px; padding: .7rem 1.5rem; }
    .btn-line:hover { background: var(--ink); color: #fff; }
    .section { padding: 64px 0; }
    .section h2 { font-size: 2.4rem; font-weight: 800; }
    .frente img { width: 100%; height: 220px; object-fit: cover; border-radius: 4px; }
    .frente h3 { font-size: 1.3rem; font-weight: 800; margin-top: 1rem; }
    .frente p { max-width: 38ch; }
    .doar { background: var(--forest); color: #fff; border-radius: 4px; padding: 2.5rem; }
    .doar h2 { color: #fff; }
    .doar p { max-width: 56ch; }
    .apoio-alternativo { border: 2px solid var(--ink); border-radius: 4px; padding: 2.5rem; }
    .site-footer { background: var(--forest); color: #fff; padding: 56px 0 32px; }
    .site-footer a, .site-footer h2 { color: #fff; }
    .navbar-dark .navbar-brand { color: #fff; }
    :focus-visible { outline: 3px solid var(--grain); outline-offset: 3px; }
    @@media (max-width: 767px) {
        .hero { padding: 48px 0 40px; }
        .hero .row, .section .row { --bs-gutter-x: 1.5rem; }
        .hero h1 { font-size: 2.75rem; }
        .section h2 { font-size: 2rem; }
        .doar, .apoio-alternativo { padding: 1.5rem; }
    }
    @@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
    html { scroll-behavior: smooth; }
</style>

<!-- BOAS-VINDAS -->
<header class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h1>Nenhuma família sem comida na mesa.</h1>
                <p class="lead mt-4">A ONG Alimento para Todos arrecada, separa e entrega cestas básicas em Osasco e região.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#como-ajudar" class="btn btn-grain">Doar agora</a>
                    <a asp-controller="Beneficiarios" asp-action="Cadastro" class="btn btn-line">Preciso de uma cesta</a>
                </div>
            </div>
            <div class="col-lg-6">
                <img class="hero-img"
                     src="@Url.Content("~/images/food-market.jpg")"
                     alt="Alimentos frescos organizados em bancadas de mercado">
            </div>
        </div>
    </div>
</header>

<main>
    <!-- COMO ATUAMOS -->
    <section class="section" aria-labelledby="titulo-atuacao">
        <div class="container">
            <h2 id="titulo-atuacao" class="mb-5">Como atuamos</h2>
            <div class="row g-5">
                <div class="col-md-4 frente">
                    <img src="@Url.Content("~/images/food-bank.jpg")" alt="Legumes e verduras organizados para doação" loading="lazy">
                    <h3>Banco de alimentos</h3>
                    <p>Recebemos itens não perecíveis, controlamos a validade e montamos as cestas básicas.</p>
                </div>
                <div class="col-md-4 frente">
                    <img src="@Url.Content("~/images/donation.jpg")" alt="Voluntário participando de uma ação de doação" loading="lazy">
                    <h3>Apoio às famílias</h3>
                    <p>O cadastro permite encaminhar pedidos de apoio para avaliação da equipe da ONG.</p>
                </div>
                <div class="col-md-4 frente">
                    <img src="@Url.Content("~/images/volunteers.jpg")" alt="Grupo de pessoas reunindo as mãos em apoio comunitário" loading="lazy">
                    <h3>Rede de voluntários</h3>
                    <p>Voluntários ajudam na triagem, na entrega e na administração. Quem tem tempo é bem-vindo.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- COMO AJUDAR / RECEBER AJUDA -->
    <section id="como-ajudar" class="section pt-0" aria-labelledby="titulo-ajudar">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="doar h-100">
                        <h2 id="titulo-ajudar">Contribua com segurança</h2>
                        <p class="mt-3 mb-0">Os canais oficiais para doações ainda não foram informados nesta página. Confirme os dados diretamente com a ONG antes de transferir dinheiro ou entregar alimentos.</p>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="h-100 p-4 p-lg-5" style="border:2px solid var(--ink); border-radius:4px;">
                        <h2 class="h3 fw-bold">Precisa de ajuda?</h2>
                        <p class="mt-3">Registre um pedido de apoio para avaliação da equipe da ONG.</p>
                        <a asp-controller="Beneficiarios" asp-action="Cadastro" class="btn btn-line mt-2">Solicitar avaliação</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

<footer class="site-footer">
    <div class="container">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <h2 class="h5 fw-bold mb-0">ONG Alimento para Todos</h2>
            <a asp-controller="Home" asp-action="Privacy">Política de privacidade</a>
        </div>
    </div>
</footer>
