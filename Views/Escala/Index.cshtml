@model IEnumerable<OngDoacao.Models.EscalaVoluntario>

@{
    ViewData["Title"] = "Escala de Voluntários";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📅 Calendário de Turnos (Escala)</h2>
        <button onclick="window.print()" class="btn btn-outline-dark fw-bold">🖨️ Exportar Escala (PDF)</button>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["MensagemSucesso"]</div>
    }

    <div class="row">
        <!-- Formulário para agendar -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Agendar Voluntário</h5>
                </div>
                <div class="card-body bg-creme">
                    <form asp-action="Agendar" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Voluntário/Funcionário</label>
                            <select name="MembroEquipeId" class="form-select" required>
                                <option value="">Selecione...</option>
                                @foreach (var membro in ViewBag.Equipe)
                                {
                                    <option value="@membro.Id">@membro.Nome (@membro.CargoOuFuncao)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Data e Hora</label>
                            <input type="datetime-local" name="DataTurno" class="form-control" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Setor de Atuação</label>
                            <select name="Setor" class="form-select" required>
                                <option value="Triagem de Alimentos">Triagem de Alimentos</option>
                                <option value="Entrega de Cestas">Entrega de Cestas</option>
                                <option value="Administrativo">Administrativo</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Gravar na Escala</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tabela da Escala -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Data / Hora</th>
                                <th>Voluntário</th>
                                <th>Setor</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var turno in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@turno.DataTurno.ToString("dd/MM/yyyy - HH:mm")</td>
                                    <td>@turno.Membro?.Nome</td>
                                    <td><span class="badge bg-primary">@turno.Setor</span></td>
                                    <td>
                                        <form asp-action="Remover" method="post">
                                            <input type="hidden" name="id" value="@turno.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>