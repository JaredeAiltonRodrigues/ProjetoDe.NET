@model OngDoacao.Models.TransacaoFinanceira

@{
    ViewData["Title"] = "Novo registro manual";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root { --ink: #17261f; --forest: #1f4d3a; --grain: #e9b93a; --line: #dcd9cd; }
    body { font-family: 'Public Sans', system-ui, sans-serif; color: var(--ink); }
    .nova h1 { font-family: 'Bricolage Grotesque', 'Public Sans', sans-serif; font-weight: 800; letter-spacing: -.02em; font-size: clamp(1.7rem, 4vw, 2.3rem); }
    .nova .painel { max-width: 640px; border: 1px solid var(--line); border-radius: 4px; background: #fff; padding: 2rem; }
    .nova .form-label { font-weight: 600; }
    .nova .form-control, .nova .form-select { border-radius: 4px; border-color: #b9b5a6; }
    .nova .form-text { color: #5b6660; }
    .nova .nfe { border-left: 4px solid var(--grain); background: #fff6dc; padding: .9rem 1rem; border-radius: 0 4px 4px 0; }
    .btn-forest { background: var(--forest); color: #fff; font-weight: 600; border-radius: 4px; padding: .75rem 1.5rem; }
    .btn-forest:hover { background: #17402f; color: #fff; }
    .btn-forest:disabled { opacity: .7; }
    :focus-visible { outline: 3px solid var(--grain); outline-offset: 2px; }
</style>

<div class="container nova mt-4 mb-5">
    <nav aria-label="Navegação">
        <a asp-controller="Financeiro" asp-action="Index" class="text-decoration-none">&larr; Voltar para a contabilidade</a>
    </nav>

    <h1 class="mt-3 mb-4">Novo registro manual</h1>

    <div class="painel">
        <form asp-action="NovaTransacao" method="post" id="form-transacao">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">Descrição</label>
                <input asp-for="Descricao" class="form-control" placeholder="Ex.: Doação anônima por PIX" autocomplete="off" required />
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Valor" class="form-label">Valor (R$)</label>
                    <input asp-for="Valor" type="number" step="0.01" min="0.01" inputmode="decimal" class="form-control" placeholder="0,00" required />
                    <div class="form-text">Informe sempre um valor positivo. O tipo define se é entrada ou saída.</div>
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Tipo" class="form-label">Tipo</label>
                    <select asp-for="Tipo" class="form-select" required>
                        <option value="Entrada">Entrada (doação)</option>
                        <option value="Saída">Saída (gasto)</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="MetodoPagamento" class="form-label">Forma de pagamento</label>
                <select asp-for="MetodoPagamento" class="form-select">
                    <option value="PIX">PIX</option>
                    <option value="Dinheiro">Dinheiro em espécie</option>
                    <option value="Transferência">Transferência bancária</option>
                </select>
                <span asp-validation-for="MetodoPagamento" class="text-danger small"></span>
            </div>

            <div class="nfe mb-4">
                <div class="form-check mb-0">
                    <input asp-for="ExigeNotaFiscal" class="form-check-input" type="checkbox" />
                    <label asp-for="ExigeNotaFiscal" class="form-check-label fw-semibold">Esta transação exige nota fiscal (SEFAZ)</label>
                </div>
                <div class="form-text ms-4">O sistema não está conectado à SEFAZ. A opção registra apenas uma pendência interna.</div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-forest" id="btn-salvar">Salvar no livro caixa</button>
                <a asp-controller="Financeiro" asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Evita lançamento duplicado se clicarem duas vezes em "Salvar".
        document.getElementById('form-transacao').addEventListener('submit', function () {
            const btn = document.getElementById('btn-salvar');
            if (this.checkValidity()) {
                btn.disabled = true;
                btn.textContent = 'Salvando...';
            }
        });
    </script>
}
